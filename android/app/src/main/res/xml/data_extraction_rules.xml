<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: kirish kaliti va profil (amora_session) bulutga ham, boshqa telefonga ham ko'chirilmaydi -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="amora_session.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="amora_session.xml" />
    </device-transfer>
</data-extraction-rules>
