# Bu fayldan nusxa oling:  cp .env.example .env   va qiymatlarni to'ldiring.
# .env fayl maxfiy: uni GitHub'ga yuklamang (.gitignore bunga yo'l qo'ymaydi).

# PostgreSQL paroli. Faqat harf va raqamlardan iborat bo'lsin (masalan: openssl rand -hex 24)
POSTGRES_PASSWORD=bu-yerga-uzun-parol-yozing

# Server tashqaridan qaysi manzilda ochiladi (taom rasmlari havolasi shundan tuziladi)
AMORA_PUBLIC_BASE_URL=https://api.example.uz

# Ish vaqti shu vaqt mintaqasida hisoblanadi
AMORA_TIMEZONE=Asia/Tashkent

# --- Telegram bot ---
# 1) @BotFather'da /newbot buyrug'i bilan bot oching va tokenini shu yerga yozing.
AMORA_BOT_TOKEN=

# 2) Buyurtmalar keladigan guruh ID'si. Botni guruhga qo'shsangiz, o'zi shu raqamni yozib beradi
#    (odatda -100 bilan boshlanadi).
AMORA_ORDERS_CHAT_ID=

# 3) Adminlarning Telegram ID raqamlari, vergul bilan. Botga /start yozsangiz, ID'ingizni aytadi.
AMORA_ADMIN_IDS=

# Bitta mijozda bir vaqtda nechta tugallanmagan buyurtma bo'lishi mumkin
AMORA_MAX_ACTIVE_ORDERS=2
# Bitta mijoz soatiga ko'pi bilan nechta buyurtma bera oladi (bekor qilinganlari ham). 0 = cheklovsiz
AMORA_MAX_ORDERS_PER_HOUR=8

# Do'kon (App Store / Google Play) tekshiruvchisi uchun sinov kodi (kamida 12 belgi, masalan:
# openssl rand -hex 8). Tekshiruvchi uni ilovadagi "Ism" maydoniga yozib, tasdiqlashni bosadi va
# Telegram'siz sinov hisobiga kiradi. Buyurtmalari guruhga "SINOV BUYURTMA" belgisi bilan tushadi.
# Tekshiruv tugagach bu qatorni o'chirib qo'ying. Bo'sh = o'chiq.
#AMORA_REVIEW_CODE=

# Konteyner umumiy Docker tarmog'iga (masalan, Caddy bilan) ulangan bo'lsa, shu yerga proksining
# manzilini yoki tarmog'ini yozing (masalan 172.18.0.0/16): faqat undan kelgan X-Forwarded-For
# sarlavhasiga ishoniladi. Yozilmasa hammasiga ishoniladi (port faqat 127.0.0.1 da ochiq bo'lsa xavfsiz).
#AMORA_FORWARDED_ALLOW_IPS=

# --- iPhone push (APNs) ---
# Kalit fayli serverda: ~/amora/secrets/apns.p8 (Apple Developer → Keys, "Apple Push Notifications service").
# Kalitning Key ID si va Apple Team ID (ikkalasi ham 10 belgi, maxfiy emas):
AMORA_APNS_KEY_ID=
AMORA_APNS_TEAM_ID=
