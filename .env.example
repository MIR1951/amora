# Bu fayldan nusxa oling:  cp .env.example .env   va qiymatlarni to'ldiring.
# .env fayl maxfiy: uni GitHub'ga yuklamang (.gitignore bunga yo'l qo'ymaydi).

# PostgreSQL paroli. Faqat harf va raqamlardan iborat bo'lsin (masalan: openssl rand -hex 24)
POSTGRES_PASSWORD=bu-yerga-uzun-parol-yozing

# Server tashqaridan qaysi manzilda ochiladi (taom rasmlari havolasi shundan tuziladi)
AMORA_PUBLIC_BASE_URL=https://api.example.uz

# Ish vaqti shu vaqt mintaqasida hisoblanadi
AMORA_TIMEZONE=Asia/Tashkent

# --- Telegram bot ---
# 1) @BotFather'da /newbot buyrug'i bilan bot oching va tokenini shu yerga yozing.
AMORA_BOT_TOKEN=

# 2) Buyurtmalar keladigan guruh ID'si. Botni guruhga qo'shsangiz, o'zi shu raqamni yozib beradi
#    (odatda -100 bilan boshlanadi).
AMORA_ORDERS_CHAT_ID=

# 3) Adminlarning Telegram ID raqamlari, vergul bilan. Botga /start yozsangiz, ID'ingizni aytadi.
AMORA_ADMIN_IDS=

# Bitta mijozda bir vaqtda nechta tugallanmagan buyurtma bo'lishi mumkin
AMORA_MAX_ACTIVE_ORDERS=2
